@page "/clients"
@implements IDisposable
@inject ClientQueryService ClientQueries
@inject ClientLookupService ClientLookup
@inject NavigationManager Navigation
@inject ILogger<Clients> Logger

<PageTitle>Clients - Professional Services Hub</PageTitle>

<PageHeader Title="Clients"
            Subtitle="Client records and relationship management.">
    <Actions>
        <SfButton IsPrimary="true"
                  OnClick="CreateClient">
            New client
        </SfButton>

        <SfButton Disabled="@(SelectedClient is null)"
                  OnClick="OpenSelectedClient">
            Open
        </SfButton>
    </Actions>
</PageHeader>

<section class="client-lookup-panel"
         aria-labelledby="client-lookup-heading">
    <div>
        <h2 id="client-lookup-heading">Quick client lookup</h2>
        <p>
            Type at least two characters from the client code or name.
        </p>
    </div>

    <div class="client-lookup-row">
        <SfAutoComplete TValue="int?"
                        TItem="ClientLookupItem"
                        @ref="ClientLookupRef"
                        ID="client-lookup"
                        DataSource="@LookupItems"
                        Placeholder="Search by code or name"
                        AllowFiltering="true"
                        DebounceDelay="300"
                        MinLength="2"
                        @bind-Value="QuickClientId">
            <AutoCompleteFieldSettings Text="@nameof(ClientLookupItem.DisplayName)"
                                       Value="@nameof(ClientLookupItem.Id)" />
            <AutoCompleteEvents TValue="int?"
                                TItem="ClientLookupItem"
                                Filtering="OnClientFiltering" />
        </SfAutoComplete>

        <SfButton Disabled="@(QuickClientId is null)"
                  OnClick="OpenQuickClient">
            Open client
        </SfButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(LookupError))
    {
        <div class="client-lookup-error" role="alert">
            @LookupError
        </div>
    }
</section>

@if (IsLoading)
{
    <p role="status">Loading clients...</p>
}
else if (!string.IsNullOrWhiteSpace(LoadError))
{
    <div role="alert">@LoadError</div>
}
else if (ClientItems.Count == 0)
{
    <p>No clients are available.</p>
}
else
{
    <SfGrid ID="ClientsGrid"
            DataSource="@ClientItems"
            AllowSelection="true"
            AllowSorting="true"
            AllowFiltering="true"
            AllowPaging="true"
            Toolbar="@ToolbarItems">

        <GridSelectionSettings Mode="@Syncfusion.Blazor.Grids.SelectionMode.Row"
                               Type="@Syncfusion.Blazor.Grids.SelectionType.Single" />

        <GridPageSettings PageSize="10" />
        <GridFilterSettings Type="@Syncfusion.Blazor.Grids.FilterType.Excel" />

        <GridEvents RowSelected="OnRowSelected"
                    RowDeselected="OnRowDeselected"
                    TValue="ClientListItem" />

        <GridColumns>
            <GridColumn Field="@nameof(ClientListItem.Code)"
                        HeaderText="Code"
                        Width="110" />

            <GridColumn Field="@nameof(ClientListItem.Name)"
                        HeaderText="Client"
                        Width="220" />

            <GridColumn Field="@nameof(ClientListItem.City)"
                        HeaderText="City"
                        Width="140" />

            <GridColumn Field="@nameof(ClientListItem.Email)"
                        HeaderText="Email"
                        Width="220" />

            <GridColumn Field="@nameof(ClientListItem.Status)"
                        HeaderText="Status"
                        Width="120" />

            <GridColumn Field="@nameof(ClientListItem.CreatedOn)"
                        HeaderText="Created"
                        Type="ColumnType.Date"
                        Format="d"
                        TextAlign="TextAlign.Right"
                        Width="120" />
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly List<string> ToolbarItems = ["Search"];

    private List<ClientListItem> ClientItems { get; set; } = [];

    private List<ClientLookupItem> LookupItems { get; set; } = [];

    private SfAutoComplete<int?, ClientLookupItem>? ClientLookupRef { get; set; }

    private CancellationTokenSource? LookupCancellation { get; set; }

    private int? QuickClientId { get; set; }

    private ClientListItem? SelectedClient { get; set; }

    private bool IsLoading { get; set; }

    private string? LoadError { get; set; }

    private string? LookupError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (IsLoading)
        {
            return;
        }

        try
        {
            IsLoading = true;
            LoadError = null;
            ClientItems = await ClientQueries.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load clients.");
            LoadError = "Unable to load clients. Please try again later.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<ClientListItem> args)
    {
        SelectedClient = args.Data;
    }

    private void OnRowDeselected(RowDeselectEventArgs<ClientListItem> _)
    {
        SelectedClient = null;
    }

    private void CreateClient()
    {
        Navigation.NavigateTo("/clients/new");
    }

    private void OpenSelectedClient()
    {
        if (SelectedClient is not null)
        {
            Navigation.NavigateTo($"/clients/{SelectedClient.Id}");
        }
    }

    private void OpenQuickClient()
    {
        if (QuickClientId is int clientId)
        {
            Navigation.NavigateTo($"/clients/{clientId}");
        }
    }

    private async Task OnClientFiltering(
        Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;

        if (ClientLookupRef is null)
        {
            return;
        }

        LookupCancellation?.Cancel();
        LookupCancellation?.Dispose();
        LookupCancellation = new CancellationTokenSource();

        try
        {
            LookupError = null;

            LookupItems = (await ClientLookup.SearchAsync(
                    args.Text ?? string.Empty,
                    LookupCancellation.Token))
                .ToList();

            await ClientLookupRef.FilterAsync(LookupItems);
        }
        catch (OperationCanceledException)
        {
            // A newer search replaced this one.
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Unable to search clients for {SearchText}.",
                args.Text);

            LookupItems = [];
            LookupError =
                "Unable to search clients. Please try again.";
        }
    }

    public void Dispose()
    {
        LookupCancellation?.Cancel();
        LookupCancellation?.Dispose();
    }
}
