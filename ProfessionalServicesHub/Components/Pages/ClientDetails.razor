@page "/clients/{Id:int}"
@inject NavigationManager Navigation

<PageTitle>Client details - Professional Services Hub</PageTitle>

<PageHeader Title="Client details"
            Subtitle="The client detail and edit workflow will be implemented in the next chapter.">
    <Actions>
        <SfButton OnClick="BackToClients">
            Back to clients
        </SfButton>
    </Actions>
</PageHeader>

<p>Selected client ID: <strong>@Id</strong></p>

@code {
    [Parameter]
    public int Id { get; set; }

    private void BackToClients()
    {
        Navigation.NavigateTo("/clients");
    }
}
