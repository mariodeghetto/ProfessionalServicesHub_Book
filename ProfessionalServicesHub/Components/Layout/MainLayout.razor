@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <SfButton CssClass="e-flat shell-menu-button"
                  @onclick="ToggleSidebar">
            Menu
        </SfButton>

        <div class="app-brand">Professional Services Hub</div>
        <div class="app-header-spacer"></div>

        <AuthorizeView>
            <Authorized Context="authentication">
                <div class="app-user-context">
                    @authentication.User.Identity?.Name
                </div>
                <a class="btn btn-sm btn-outline-secondary"
                   href="/account/logout">
                    Sign out
                </a>
            </Authorized>
        </AuthorizeView>
    </header>

    <SfSidebar Width="260px"
               Type="@SidebarType.Auto"
               Target=".app-main"
               MediaQuery="(min-width: 768px)"
               @bind-IsOpen="SidebarOpen">
        <ChildContent>
            <NavMenu />
        </ChildContent>
    </SfSidebar>

    <main class="app-main" id="main-content">
        <div class="app-content">
            @Body
        </div>
    </main>
</div>

<AppToastHost />
<SfDialogProvider />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool SidebarOpen { get; set; } = true;

    private void ToggleSidebar()
    {
        SidebarOpen = !SidebarOpen;
    }
}
